    {"category": "その他", "domain_regex": "(^|\\.)suumo\\.jp$", "note": "住まい関連(SUUMO)"},
    {"category": "その他", "domain_regex": "(^|\\.)mansion-note\\.com$", "note": "住まい関連(マンションノート)"}
  ],

  "importance_rules": [
    {
      "category": "仕事",
      "subject_regex": "^\\d{2}月\\d{2}日 .+さんのスケジュール$",
      "verdict": "確認不要",
      "note": "自動配信の自分宛スケジュール通知"
    },
    {
      "category": "仕事",
      "subject_regex": "^アンケート：",
      "verdict": "確認不要",
      "note": "内容判定はせず到着事実のみ。カテゴリ別一覧には引き続き表示"
    },
    {
      "category": "仕事",
      "subject_regex": "^回覧・レポート：",
      "verdict": "確認不要",
      "note": "内容判定はせず到着事実のみ。カテゴリ別一覧には引き続き表示"
    },
    {
      "category": "金融",
      "subject_regex": "認証コード",
      "verdict": "確認不要",
      "note": "OTPは翌朝には失効しているため、内容に関わらず確認不要"
    },
    {
      "category": "EC",
      "subject_regex": ".*",
      "verdict": "確認不要",
      "note": "配送/購入は事実分類のみで重要度判定はしない。不審な注文への気づきはカテゴリ一覧の目視で行う"
    }
  ]
}
